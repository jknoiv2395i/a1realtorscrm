# =============================================================================
# A1 Real Estate CRM — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values before running.
# Never commit the populated .env.local to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma ORM.
# For Supabase: postgres://[user]:[password]@[host]:[port]/[db]?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/a1_crm_prod?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public-facing URL for the deployed CRM instance (no trailing slash)
NEXT_PUBLIC_APP_URL="https://crm.a1realestate.in"

# ─── Indian Market Defaults ───────────────────────────────────────────────────
# Default metro market displayed on initial load.
# Supported values: MH (Maharashtra), KA (Karnataka), DL (Delhi NCR), TS (Telangana)
NEXT_PUBLIC_DEFAULT_MARKET="MH"

# ─── Google Sheets & Docs Integration ─────────────────────────────────────────
# Google Cloud Service Account Email & Private Key (format with \n)
GOOGLE_SERVICE_ACCOUNT_EMAIL="a1-crm-sync@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Master Google Spreadsheet ID
GOOGLE_SHEET_ID="1xYzAbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# Google Doc Template IDs for Dynamic Generation
GOOGLE_DOC_COST_SHEET_TEMPLATE_ID="1TemplateDocIdCostSheetXXXXXXXXXXXX"
GOOGLE_DOC_ALLOTMENT_TEMPLATE_ID="1TemplateDocIdAllotmentLetterXXXXXX"

